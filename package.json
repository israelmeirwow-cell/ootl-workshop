{
  "name": "out-of-the-loop",
  "version": "1.0.0",
  "description": "Vallora Estate: an editorial landing page for a family wine estate, built with Vite, React 19, Tailwind CSS 4 and Motion.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:gh": "tsc -b && BASE_PATH=/ootl-workshop/ vite build && touch dist/.nojekyll",
    "preview": "vite preview",
    "start": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "@fontsource-variable/frank-ruhl-libre": "^5.3.0",
    "@fontsource-variable/heebo": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "motion": "^12.42.2",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
